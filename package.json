{
  "name": "@jorgemartins72/cliente-session",
  "version": "0.3.0",
  "description": "Session manager for Nuxt/Vue: browser mode (storage) and server mode (h3 sealed cookie + API proxy)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "auth",
    "bff",
    "client-side",
    "h3",
    "nitro",
    "nuxt",
    "proxy",
    "session",
    "storage",
    "vue"
  ],
  "author": "Jorge Martins <jorge.martins@jamar.dev.br>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamar-dev/cliente-session.git"
  },
  "homepage": "https://github.com/jamar-dev/cliente-session#readme",
  "license": "MIT",
  "devDependencies": {
    "h3": "^1.15.11",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "default": "./dist/server.mjs"
    }
  },
  "peerDependencies": {
    "h3": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  }
}
